# Route-Snippet des wordpress-Bundles (Default-Route, deshalb 90er-Präfix —
# spezifischere App-Routen wie 20-shop kommen davor). Wird vom proxy-Bundle
# aus docker/config/proxy/ geladen und per envsubst gerendert.
location / {
    proxy_pass http://wordpress:80;
    proxy_set_header Host              $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-Port  ${XO_PROXY_HTTPS_PORT};
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
}
