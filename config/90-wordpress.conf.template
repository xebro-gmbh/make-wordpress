# Route snippet of the wordpress bundle (default route, hence the 90 prefix —
# more specific app routes like 20-shop come first). Loaded by the proxy
# bundle from docker/config/proxy/ and rendered via envsubst.
location / {
    proxy_pass http://wordpress:80;
    proxy_set_header Host              $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-Port  ${XO_PROXY_HTTPS_PORT};
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
}
